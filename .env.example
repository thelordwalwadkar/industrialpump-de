# Storyblok (EU region space). Leave STORYBLOK_TOKEN empty to build from the local seed stories in storyblok/content/.
STORYBLOK_TOKEN=
STORYBLOK_PREVIEW_TOKEN=
# Management API (only for npm run sb:push / sb:seed). Never commit.
STORYBLOK_OAUTH_TOKEN=
STORYBLOK_SPACE_ID=
# Public site URL (canonical, sitemap, JSON-LD @id). No trailing slash.
PUBLIC_SITE_URL=https://www.industrialpump.de
# Form endpoint for /kontakt and /angebot (stub - TODO: server-side handler)
PUBLIC_FORM_ENDPOINT=
