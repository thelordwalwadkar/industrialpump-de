                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Harte Partikel werden dank des weichen Gummis leicht eingedrückt und anschließend wieder in die Flüssigkeit aufgenommen."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
