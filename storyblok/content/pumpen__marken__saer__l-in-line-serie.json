                  "content": [
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 2
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Toleranzen"
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Pumpe UNI EN ISO 9906:2012 Klasse 3B."
                        },
                        {
                          "type": "hard_break"
                        },
                        {
                          "type": "text",
                          "text": "Motor: IEC 60034-1."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "_uid": "5092beba3087",
            "component": "section_column",
            "content": [
              {
