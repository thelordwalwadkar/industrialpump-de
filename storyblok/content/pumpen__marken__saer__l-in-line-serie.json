                },
                {
                  "type": "text",
                  "text": "SAER-Pumpen",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "? Sehen Sie sich unser gesamtes Sortiment an"
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
