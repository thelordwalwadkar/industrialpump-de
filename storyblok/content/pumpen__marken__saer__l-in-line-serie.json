    "component": "page_series",
    "h1": "SAER L IN-LINE: Inlinepumpen von SAER",
    "nav_title": "SAER L IN-LINE: Inlinepumpen von SAER",
    "seo_title": "SAER L IN-LINE: Inlinepumpen aus Gusseisen bis 75 kW",
    "seo_description": "SAER L IN-LINE Inlinepumpen aus Gusseisen für Heiz-, Kühl- und Brauchwasser: bis 75 kW und 16 bar. Jetzt Angebot oder Beratung anfordern.",
    "intro": "Die SAER L IN-LINE sind Inlinepumpen mit Gehäuse aus Gusseisen für die Umwälzung von Warm- und Kaltwasser in Bau- und Industrieanlagen. Sie decken Leistungen von 0,18 kW bis 75 kW und Betriebsdrücke bis 16 bar ab.",
    "series_name": "L IN-LINE",
    "image": {
      "filename": "/img/nl/pomptypes-merk-saer-saer-inline.webp",
      "alt": "SAER L IN-LINE: Inlinepumpen von SAER",
      "width": 460,
      "height": 460
    },
    "pump_type": "kreiselpumpen",
    "use_case_line": "Inlinepumpen von SAER",
    "body": [
      {
