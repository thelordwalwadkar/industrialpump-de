                        "level": 2
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Lieber direkt Kontakt aufnehmen"
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Haben Sie Fragen oder möchten Sie lieber direkt mailen oder anrufen? Kein Problem, das IPG-Team engagierter Pumpenexperten steht für Sie bereit."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "+31 251 222 566",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "hard_break"
                        },
                        {
                          "type": "text",
                          "text": "Erreichbar an Werktagen"
                        },
                        {
                          "type": "hard_break"
                        },
                        {
                          "type": "text",
                          "text": "von 08:00 bis 17:00 Uhr"
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "info@industrialpumps.nl",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "hard_break"
                        },
                        {
                          "type": "text",
                          "text": "Tipp: Fügen Sie unsere E-Mail-Adresse Ihren Kontakten hinzu, damit unsere Antwort nicht im Spam-Ordner landet."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Besuchsadresse",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "hard_break"
                        },
                        {
                          "type": "text",
                          "text": "Concordiastraat 30, 1951 AS Velsen-Noord"
                        }
                      ]
                    }
