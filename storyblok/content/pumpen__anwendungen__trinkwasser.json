                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Komfort",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": ": Trinkwasserpumpen lassen sich aus der Ferne bedienen und überwachen, sodass Sie jederzeit über Betrieb und Wartung der Pumpe informiert sind."
                        }
                      ]
                    }
                  ]
                },
