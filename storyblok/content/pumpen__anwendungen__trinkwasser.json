                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Verfügbarer Platz und Installationsanforderungen"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Wartungsanforderungen und deren Kosten"
                        }
                      ]
                    }
