                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Mit Lieferanten Technik und Lieferzeiten abstimmen"
                        }
                      ]
