                "_uid": "f219a3540626",
                "component": "faq",
                "heading": "Häufige Fragen",
                "items": [
                  {
                    "_uid": "d427bd1691c6",
                    "component": "faq_item",
                    "question": "Welche Pumpenarten eignen sich für landwirtschaftliche Anwendungen?",
                    "answer": "Für landwirtschaftliche Anwendungen eignen sich verschiedene Pumpenarten, darunter Kreiselpumpen, selbstansaugende Pumpen, Tauchmotorpumpen, Brunnenpumpen und Druckpumpen."
                  },
                  {
                    "_uid": "9c25b789038d",
                    "component": "faq_item",
                    "question": "Warum sind bestimmte Pumpen für landwirtschaftliche Anwendungen besser geeignet?",
                    "answer": "Die Wahl einer bestimmten Pumpe hängt von mehreren Faktoren ab, etwa von der Art der zu fördernden Flüssigkeit, der benötigten Menge, den Druckanforderungen und dem Aufstellort der Pumpe."
                  },
                  {
                    "_uid": "49d2d3eafd3d",
                    "component": "faq_item",
                    "question": "Wie wird die Leistung einer Beregnungspumpe für die Landwirtschaft bestimmt?",
                    "answer": "Die Leistung einer Beregnungspumpe für die Landwirtschaft bestimmt sich nach der Flüssigkeitsmenge, die pro Zeiteinheit gefördert werden muss. Sie wird in Litern pro Minute oder in Gallonen pro Minute angegeben."
                  },
                  {
                    "_uid": "66afd86d134c",
                    "component": "faq_item",
                    "question": "Wie wartet man eine Pumpe für landwirtschaftliche Anwendungen?",
                    "answer": "Eine Pumpe für landwirtschaftliche Anwendungen sollte regelmäßig von einer qualifizierten Fachkraft gewartet werden. Dazu gehören die Inspektion von Verschleißteilen, der Austausch von Verbrauchsteilen und die Reinigung der Pumpe."
                  }
                ]
              }
            ]
          }
        ]
