                        {
                          "type": "text",
                          "text": "Herstellerunabhängige Pumpenberatung: offizieller Händler namhafter Marken"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "_uid": "4bf28126c751",
            "component": "section_column",
            "content": [
              {
                "_uid": "7e809aac2a63",
                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Die Industrial Pump Group kann Sie mit Pumpen vieler Marken versorgen, auch wenn diese nicht auf der Website angeboten werden."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Suchen Sie etwas Bestimmtes? Dann nehmen Sie jederzeit unverbindlich Kontakt mit dem IPG-Team auf."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
