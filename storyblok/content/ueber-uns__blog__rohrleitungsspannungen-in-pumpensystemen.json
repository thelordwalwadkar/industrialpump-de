      {
        "_uid": "0e6c7295d9ca",
        "component": "rich_text",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "heading",
              "attrs": {
                "level": 3
              },
              "content": [
                {
                  "type": "text",
                  "text": "Wie minimieren Sie Rohrleitungsspannungen?"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Es gibt verschiedene Maßnahmen, mit denen Sie Rohrleitungsspannungen minimieren und so Zuverlässigkeit und Lebensdauer Ihres Pumpensystems sichern können:"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Richtige Abstützung und Verankerung",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": ": Sorgen Sie dafür, dass Rohrleitungen gut abgestützt und verankert sind, um Bewegungen zu minimieren. Flexible Kupplungen können außerdem eingesetzt werden, um thermische Ausdehnung und Schrumpfung aufzunehmen."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Einsatz von Kompensatoren",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": ": Kompensatoren können thermische Ausdehnung aufnehmen und so die Spannungen auf die Rohrleitungen verringern."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Beurteilung und Berechnung von Spannungen",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": ": Bei der Auslegung eines Pumpensystems sind Spannungsberechnungen wesentlich, um sicherzustellen, dass die Rohrleitungen den zu erwartenden Belastungen standhalten."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Regelmäßige Wartung und Inspektion",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": ": Durch regelmäßige Wartung und Inspektion können Sie spannungsbedingte Probleme frühzeitig erkennen und beheben, bevor sie zu größeren Störungen führen."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ],
