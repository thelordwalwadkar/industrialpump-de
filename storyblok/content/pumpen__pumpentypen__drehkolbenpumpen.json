                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Energieeffizienz",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Sehr effizient bei geringem Energieverbrauch, was zu niedrigeren Betriebskosten und mehr Nachhaltigkeit führt."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
