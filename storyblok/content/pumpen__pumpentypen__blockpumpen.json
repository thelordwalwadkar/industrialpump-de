              ]
            },
            {
              "type": "heading",
              "attrs": {
                "level": 3
              },
              "content": [
                {
                  "type": "text",
                  "text": "Beratung und Verkauf: die passende Lösung für Ihre Anwendung"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
