                  "filename": "/img/nl/pomptypes-merk-homa-homa-tp.webp",
                  "alt": "Blaue HOMA TP Tauchmotorpumpe aus Gusseisen für Abwasser und Schlamm mit Einkanallaufrad",
                  "width": 600,
                  "height": 600
                }
              },
              {
                "_uid": "932e5ebf6885",
                "component": "rich_text",
                "content": {
                  "type": "doc",
