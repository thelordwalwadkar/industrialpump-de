                    {
                      "type": "heading",
                      "attrs": {
                        "level": 3
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "HOMA Baureihe TP"
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Die Baureihe TP von HOMA besteht aus Pumpen mit geschlossenem Einkanallaufrad und freiem Durchgang. Das ist besonders geeignet zum Fördern von Schmutz- und Abwasser sowie Schlamm. Die Pumpe ist in Gusseisen ausgeführt."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "_uid": "f37718886331",
            "component": "section_column",
