                  "alt": "Schwarze HOMA GRP Tauchmotorpumpe mit Schneidwerk für Abwasser und Fäkalien",
                  "width": 600,
                  "height": 600
                }
              },
              {
                "_uid": "66b4d035e136",
                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 3
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "HOMA Baureihe GRP"
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Die HOMA GRP Tauchmotorpumpe eignet sich sehr gut zum Fördern von Abwasser und Fäkalien. Das eingebaute Schneidwerk sorgt dafür, dass Feststoffe zerkleinert werden. Dadurch können Pumpe und Druckleitung nicht verstopfen."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
