                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Geeignet für HVAC-Systeme",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Geeignet für HVAC-Systeme in Gebäuden wie Krankenhäusern und Bürogebäuden, in denen ein konstanter Wasserdruck für Heiz- und Kühlanwendungen wesentlich ist."
                        }
