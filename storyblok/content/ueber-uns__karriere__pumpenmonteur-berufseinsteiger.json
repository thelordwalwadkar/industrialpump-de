            {
              "type": "heading",
              "attrs": {
                "level": 3
              },
              "content": [
                {
                  "type": "text",
                  "text": "Sie erreichen uns telefonisch unter [[PLATZHALTER: Telefon]] oder über das Formular weiter unten"
