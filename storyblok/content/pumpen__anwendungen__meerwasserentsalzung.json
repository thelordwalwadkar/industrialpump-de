      {
        "_uid": "76a0dac2ece5",
        "component": "section_row",
        "layout": "columns",
        "columns": [
          {
            "_uid": "1d3ce09d8d02",
            "component": "section_column",
            "content": [
              {
                "_uid": "d717cdd7a650",
                "component": "rich_text",
                "content": {
                  "type": "doc",
