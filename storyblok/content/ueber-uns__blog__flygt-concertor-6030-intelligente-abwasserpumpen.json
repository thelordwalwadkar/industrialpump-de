{
  "id": 3997138411,
  "uuid": "ee3f7deb-794e-293f-ce2b-b3e3a27a0b6b",
  "name": "Flygt Concertor® 6030: intelligente Abwasser-Tauchmotorpumpe",
  "slug": "flygt-concertor-6030-intelligente-abwasserpumpen",
  "full_slug": "ueber-uns/blog/flygt-concertor-6030-intelligente-abwasserpumpen",
  "position": 28,
  "content": {
    "component": "page_blog_post",
    "h1": "Flygt Concertor® 6030: intelligente Abwasser-Tauchmotorpumpe",
    "seo_title": "Flygt Concertor 6030: intelligente Abwasserpumpe",
    "seo_description": "Flygt Concertor 6030: Abwasser-Tauchmotorpumpe bis 13,4 kW und 540 m³/h mit IE4-Motor. Jetzt Beratung und Angebot bei IPG anfordern.",
    "intro": "Die Flygt Concertor® 6030 ist eine intelligente Abwasser-Tauchmotorpumpe von Xylem für höhere Förderleistungen, die sich an wechselnde Betriebsbedingungen anpasst. IPG berät als offizieller Channel Partner von Xylem zu Auswahl, Installation und Wartung.",
    "publication_date": "2025-01-06",
    "article": {
      "type": "doc",
      "content": []
    },
    "body": [
      {
        "_uid": "c6ebdc9ccd08",
        "component": "rich_text",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "heading",
              "attrs": {
                "level": 4
              },
              "content": [
                {
                  "type": "text",
                  "text": "Ein neuer Standard bei intelligenten Abwasserpumpen: Flygt Concertor® 6030"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "IPG",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " stellt als offizieller Channel Partner von "
                },
                {
                  "type": "text",
                  "text": "Xylem",
                  "marks": [
                    {
                      "type": "link",
                      "attrs": {
                        "href": "/ueber-uns/blog/ipg-und-xylem",
                        "linktype": "url"
                      }
                    },
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " die neue "
                },
                {
                  "type": "text",
                  "text": "Flygt Concertor® 6030",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " vor – eine intelligente Abwasser-Tauchmotorpumpe, die für höhere Förderleistungen und optimale Leistungswerte ausgelegt ist. Diese Neuentwicklung verbindet moderne Technik, Energieeffizienz und Zuverlässigkeit und bietet eine Lösung für die wachsenden Anforderungen im Abwassermanagement. In diesem Artikel stellen wir die wichtigsten Merkmale und Vorteile der Flygt Concertor® 6030 vor und zeigen, wie "
                },
                {
                  "type": "text",
                  "text": "IPG",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " Sie bei der Umsetzung unterstützen kann."
                }
              ]
            },
            {
              "type": "heading",
              "attrs": {
                "level": 3
              },
              "content": [
                {
                  "type": "text",
                  "text": "Eine Weiterentwicklung im Abwassermanagement"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Seit der Einführung im Jahr "
                },
                {
                  "type": "text",
                  "text": "2016",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " hat die "
                },
                {
                  "type": "text",
                  "text": "Flygt Concertor®-Baureihe",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " Abwasserpumpen durch die Integration intelligenter Technik grundlegend verändert. Die neue "
                },
                {
                  "type": "text",
                  "text": "Flygt Concertor® 6030",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " hebt diese Technik auf die nächste Stufe, mit Leistungen bis "
                },
                {
                  "type": "text",
                  "text": "13,4 kW",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " und einem Förderstrom von bis zu "
                },
                {
                  "type": "text",
                  "text": "540 m³/h",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Dank der Zusammenarbeit von IPG und Xylem erhalten Kunden fachkundige Beratung, verlässliche Unterstützung und eine effiziente Umsetzung dieser neuen Technik."
                }
              ]
            },
            {
              "type": "heading",
              "attrs": {
                "level": 3
              },
              "content": [
                {
                  "type": "text",
                  "text": "Intelligenz für optimale Leistung"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Die Concertor® 6030 kombiniert innovative Software, Sensorik und Hardware, um sich in Echtzeit an veränderte Bedingungen anzupassen, etwa an schwankende Förderströme bei plötzlichem Regen. Das führt zu:"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Bis zu 70 % Energieeinsparung",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": " im Vergleich zu herkömmlichen Systemen."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Minimalen Stillstandszeiten",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": " dank automatischer Verstopfungserkennung und Selbstreinigungsfunktionen."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Anpassung an wechselnde Betriebsbedingungen",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": " ohne mechanische Änderungen."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "_uid": "f0ed843b372a",
        "component": "image_block",
