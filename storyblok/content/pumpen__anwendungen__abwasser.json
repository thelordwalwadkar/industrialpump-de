  "content": {
    "component": "page_topic",
    "h1": "Abwasserpumpen",
    "nav_title": "Abwasserpumpen",
    "seo_title": "Abwasserpumpen für Industrie und Kläranlagen",
    "seo_description": "Abwasserpumpen für verschmutztes Wasser: Tauchmotor-, Exzenterschnecken- und Kreiselpumpen. Jetzt Beratung oder Angebot anfordern.",
    "intro": "Abwasserpumpen fördern verschmutztes Wasser aus Haushalten, Betrieben und Industrieanlagen zu Kläranlagen. Sie richten sich an Betreiber und Planer, die Abwasser auch unter anspruchsvollen Bedingungen zuverlässig und wirtschaftlich fördern müssen.",
    "topic_kind": "pumpentyp",
    "body": [
      {
        "_uid": "f782381a79b8",
        "component": "rich_text",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Eine "
                },
                {
                  "type": "text",
                  "text": "Abwasserpumpe",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " ist erforderlich, um verschmutztes Wasser aus Haushalten, Betrieben und Industrieanlagen wirksam zu Kläranlagen zu fördern. Diese Pumpen arbeiten auch unter anspruchsvollen Bedingungen zuverlässig und langlebig."
                }
              ]
            },
