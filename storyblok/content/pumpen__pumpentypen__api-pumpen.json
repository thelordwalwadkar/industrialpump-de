                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Sulzer-Pumpen",
                          "marks": [
                            {
                              "type": "link",
                              "attrs": {
                                "href": "/pumpen/marken/sulzer",
