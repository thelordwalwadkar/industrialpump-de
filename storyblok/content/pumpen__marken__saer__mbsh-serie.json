      {
        "_uid": "641d843cef44",
        "component": "section_row",
        "layout": "columns",
        "columns": [
          {
            "_uid": "e28945b8e48b",
            "component": "section_column",
            "content": [
              {
                "_uid": "44df8b996922",
                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 2
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Aufbau der Pumpe"
                        }
                      ]
                    },
                    {
                      "type": "bullet_list",
                      "content": [
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Außenmantel: vollständig aus Edelstahl AISI 304, einschließlich Druckgehäuse mit Gewindeausgang 11″ G."
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Laufräder und Diffusoren: verschleißfestes, thermoplastisches Kunstharz. Diffusoren mit selbsteinstellenden Spaltringen."
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Monoblock-Pumpen- und Motorwelle vollständig aus Edelstahl AISI 431, an drei Punkten gelagert."
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Dauergeschmierte Lager."
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Dichtungen: zwei Gleitringdichtungen: Graphit/Aluminiumoxid-Dichtung auf der Motorseite; Aluminiumoxid/Siliziumkarbid-Dichtung auf der Pumpenseite. Ölkammer dazwischen angeordnet (FDA-zugelassenes, ungiftiges Öl)."
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Motor: Asynchron-Induktionsmotor mit Außenmantel aus Stahl AISI 304, gekühlt durch die geförderte Flüssigkeit."
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Schutzart: IP68. Die Einheit aus Pumpe und Motor lässt sich leicht demontieren und reparieren."
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Dreiphasige Ausführungen: 380-400-415 V, 50 Hz; Schutzeinrichtungen und elektrischer Schaltschrank auf Anfrage."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Einphasige Ausführungen: 220-230 V / 230-240 V, 50 Hz; kompletter elektrischer Schaltschrank mit Schutzeinrichtung und auf Wunsch mitgeliefertem Schuko-Stecker."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Kabel Typ H07-RNF serienmäßig mitgeliefert: Baureihe MBS: L = 20 m / Baureihen MBS-H und MBS-L: L = 2 m."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "_uid": "da7676b1edb0",
            "component": "section_column",
            "content": [
              {
                "_uid": "6671ad1cf06b",
                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 2
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Spezifikationen"
                        }
                      ]
                    },
                    {
                      "type": "bullet_list",
                      "content": [
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Qmax: 18 m³/h – Hmax: 113 m"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Temperatur der zu fördernden Flüssigkeit: min. 0 °C – max. 40 °C."
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Maximal zulässige Sandmenge im Wasser: 50 g/m³."
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Durchgang für Feststoffe: max. 2,5 mm (Baureihe X: 2 mm)."
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Minimaler Flüssigkeitsstand: 100 mm ab der Unterkante des Ansaugsiebs."
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Maximale Einsatztiefe: bis 70 m unter dem Wasserspiegel."
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "_uid": "15fe457b82b2",
            "component": "section_column",
            "content": [
              {
                "_uid": "277b9ea19028",
                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 2
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Installation"
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Die Pumpen der Baureihe MBS können in 6-Zoll-Tiefbrunnen als Unterwassermotorpumpen oder als Tauchmotorpumpen in offenen Brunnen, Becken, Bottichen oder Tanks installiert werden. Die Ausführungen MBS-H und MBS-L sind für die Aufstellung an der Oberfläche vorgesehen. Die Elektropumpen der Baureihe MBS eignen sich für den Betrieb mit Frequenzumrichter."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "MBS",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": ": elektrische Tauchpumpe; MBS-CG: einphasige Ausführung mit Schwimmer."
                        },
                        {
                          "type": "hard_break"
                        },
                        {
                          "type": "text",
                          "text": "KMBS",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": ": Elektropumpe MBS + 20 m Kabel + Schwimmerschalter + Schaltschrank"
                        },
                        {
                          "type": "hard_break"
                        },
                        {
                          "type": "text",
                          "text": "MBS-H",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": ": Ausführung mit Saugblock mit Einlass 11″ G. MBS-L: Ausführung mit Inline-Ein- und Auslass."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
