                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Maximale Eintauchtiefe: 300 m unter dem Flüssigkeitsspiegel."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Drehrichtung: im Uhrzeigersinn, vom Druckstutzen aus gesehen."
                        }
