                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Förderung aus Brunnen mit einem Mindestdurchmesser von 156 mm, aus Tanks oder natürlichen Becken."
                        }
                      ]
                    }
                  ]
                }
