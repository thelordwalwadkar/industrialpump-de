        "image": {
          "filename": "/img/nl/pomptypes-merk-saer-saer-ncb.webp",
          "alt": "Grüne SAER NCB Kreiselpumpe mit Flanschansaugung für HVAC und industrielle Anwendungen",
          "width": 500,
          "height": 500
        }
      },
      {
