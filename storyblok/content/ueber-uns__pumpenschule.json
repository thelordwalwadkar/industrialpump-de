                        "level": 4
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Pumpenschule der Industrial Pump Group"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "_uid": "70698b724ef8",
            "component": "section_column",
            "content": [
              {
                "_uid": "c8a7a0cb42d7",
                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Die Pumpenschule der Industrial Pump Group ist eine Schulung, in der Unternehmen und Einzelpersonen das Wissen und die Fertigkeiten erwerben können, die für die Arbeit mit Industriepumpen nötig sind. Sie soll den Teilnehmern praktisches und technisches Wissen vermitteln, damit sie Probleme in der Praxis besser lösen und Herausforderungen besser bewältigen können."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "_uid": "fcef040bb197",
        "component": "section_row",
        "layout": "columns",
        "columns": [
          {
            "_uid": "1473d4a9dc08",
            "component": "section_column",
            "content": [
              {
                "_uid": "129b0425816f",
                "component": "image_block",
                "image": {
                  "filename": "/img/nl/pompschool-klaslokaal.webp",
                  "alt": "Schulungsraum der Pumpenschule",
                  "width": 1000,
                  "height": 667
                }
              }
            ]
          },
          {
            "_uid": "6ba062998c59",
            "component": "section_column",
            "content": [
              {
                "_uid": "3debdb4d2d72",
                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 3
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Wissen über Industriepumpen aufbauen"
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Die Pumpenschule bietet ein umfassendes Curriculum zu den Grundlagen der industriellen Pumpentechnik, einschließlich Themen wie Pumpenauslegung, Auswahl, Installation, Bedienung und Wartung. Die Schulungen werden von erfahrenen Fachleuten gehalten, die langjährige Erfahrung in der Industrie haben."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Die Pumpenschule der Industrial Pump Group zielt nicht nur darauf, Wissen und Fertigkeiten der Teilnehmer zu verbessern, sondern bietet auch die Gelegenheit, sich mit anderen Fachleuten der Branche zu vernetzen und auszutauschen. So entsteht ein lehrreiches und unterstützendes Umfeld, in dem Teilnehmer Ideen teilen und neue Erkenntnisse gewinnen."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Kurz gesagt: Die Pumpenschule der Industrial Pump Group richtet sich an Unternehmen und Einzelpersonen, die ihr Wissen und ihre Fertigkeiten rund um Industriepumpen erweitern möchten. Die Schulung ist eine Investition in die Zukunft, die zu mehr Effizienz und Erfolg in der Industrie beitragen soll."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "_uid": "2ce94475f82d",
        "component": "rich_text",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "heading",
              "attrs": {
                "level": 3
              },
              "content": [
                {
                  "type": "text",
                  "text": "Verschiedene Möglichkeiten: Kurs für Ihre Organisation"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Bei den Kursen der Industrial Pump Group ist es üblich, dass die Organisation den Kurs für ihre Mitarbeiter ausrichtet. Der Kursleiter von IPG kommt zu Ihnen vor Ort und hält den Kurs an einem oder mehreren Tagen. Andere Formen sind ebenfalls denkbar, etwa ein Einzelkurs mit dem Kursleiter."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Möchten Sie alle Möglichkeiten kennenlernen?",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "hard_break"
                },
                {
                  "type": "text",
                  "text": "Das IPG-Team mit engagierten Pumpenexperten steht für Sie bereit."
                },
                {
                  "type": "hard_break"
                },
                {
                  "type": "text",
                  "text": "Nehmen Sie schnell über das Formular Kontakt auf oder rufen Sie"
                },
                {
                  "type": "hard_break"
                },
                {
                  "type": "text",
                  "text": "werktags zwischen 08:00 und 17:00 Uhr an."
                },
                {
                  "type": "hard_break"
                },
                {
                  "type": "text",
                  "text": "Tel. +31 251 222 566",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "heading",
              "attrs": {
                "level": 3
              },
              "content": [
                {
                  "type": "text",
                  "text": "Kurse von IPG"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Die Pumpenschule der Industrial Pump Group bietet nicht nur die Grundausbildung zu Industriepumpen an, sondern auch eine Reihe weiterer Kurse zu speziellen Themen und Fertigkeiten. Damit ist die Pumpenschule von IPG eine vollständige und umfangreiche Wissensquelle für Unternehmen und Einzelpersonen in der Industrie."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Einer dieser Kurse behandelt zum Beispiel Gleitringdichtungen (Mechanical Seals), die eine wichtige Rolle bei der Vermeidung von Leckagen an Industriepumpen spielen. Die Teilnehmer erhalten einen Überblick über die verschiedenen Arten von Gleitringdichtungen und die Vorgehensweise bei Einbau und Wartung."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Außerdem wird ein Grundlagenkurs Pumpen angeboten. Er vermittelt Kenntnisse über die verschiedenen Pumpenarten, ihre Einsatzbereiche und die Grundprinzipien ihrer Funktionsweise. Dieser Kurs bietet eine gute Grundlage für alle, die neu in der Branche sind und die wesentlichen Aspekte von Industriepumpen verstehen möchten."
                }
              ]
            }
          ]
        }
      },
