                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Technische Spezifikationen"
                        }
                      ]
                    },
                    {
                      "type": "bullet_list",
                      "content": [
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Motor mit Käfigläufer im Ölbad (ungiftig und dielektrisch) zur Schmierung der Kugellager und für bessere Kühlung."
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "2-polige Motoren (von 0,6 bis 1,5 kW) und 4-polige Motoren (von 1,8 bis 4 kW)."
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Gleitringdichtung, geschützt durch ein sandabweisendes Labyrinth."
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Maximale Eintauchtiefe: 5 m."
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
