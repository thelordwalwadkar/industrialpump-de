                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Förderhöhe: bis 21,0 m"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Stromversorgung: dreiphasig und einphasig, 50 Hz"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Leistung: von 0,60 kW bis 4,00 kW"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Temperatur der geförderten Flüssigkeit: bis 50,0 °C"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Maximale Eintauchtiefe: 5,0 m"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Freier Durchgang: bis 65,0 mm"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
