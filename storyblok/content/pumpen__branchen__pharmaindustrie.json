                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Exzenterschneckenpumpen",
                          "marks": [
                            {
