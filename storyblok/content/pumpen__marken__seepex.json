                "component": "image_block",
                "image": {
                  "filename": "/img/nl/pomptypes-merk-seepex-seepex-n.webp",
                  "alt": "SEEPEX Baureihe N, Exzenterschneckenpumpe für zähe Flüssigkeiten und Feststoffe",
                  "width": 240,
                  "height": 158
                }
              },
              {
                "_uid": "396fab45115b",
                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 3
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Seepex Baureihe N"
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Medien mit hohem Feststoffanteil und Flüssigkeiten mit unterschiedlichen Viskositäten."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Von dieser Baureihe liefern wir die Ausführungen: BN, NS/N",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "_uid": "74f6f561421c",
            "component": "section_column",
            "content": [
              {
                "_uid": "341669e1181d",
                "component": "image_block",
                "image": {
                  "filename": "/img/nl/pomptypes-merk-seepex-seepex-d.webp",
                  "alt": "SEEPEX Baureihe D, Dosierpumpe für kleinste Mengen in industriellen Anwendungen",
                  "width": 1280,
                  "height": 961
                }
              },
              {
                "_uid": "75eec4664564",
                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 3
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Seepex Baureihe D"
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Die Pumpen dieser Baureihe eignen sich zum Fördern und Dosieren kleinster Mengen in verschiedenen Industrien."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Von dieser Baureihe liefern wir die Ausführungen: MD, MDP, MDC, MDTC, MDT, MDF",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "_uid": "882eb0eccf5f",
            "component": "section_column",
            "content": [
              {
                "_uid": "78f9f60abecb",
                "component": "image_block",
                "image": {
                  "filename": "/img/nl/pomptypes-merk-seepex-seepex-t.webp",
                  "alt": "SEEPEX Baureihe T, Pumpe mit Trichter für nicht fließfähige oder hochviskose Medien",
                  "width": 240,
                  "height": 158
                }
              },
              {
                "_uid": "c19804708e98",
                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 3
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Seepex Baureihe T"
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Mit diesen Pumpen lassen sich Flüssigkeiten mit hoher Viskosität oder nicht fließfähige Produkte fördern. Pumpen dieser Baureihe sind auch mit Trichter und/oder Schnecke für eine gleichmäßige Produktzufuhr lieferbar."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Von dieser Baureihe liefern wir die Ausführungen: BTQ, BT, BTM, BTE, BTI, BTHE/BTH, BTES, BTEI",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "_uid": "a2fdcbc53690",
            "component": "section_column",
            "content": [
              {
                "_uid": "e36df925391e",
                "component": "image_block",
                "image": {
                  "filename": "/img/nl/pomptypes-merk-seepex-seepex-cs.webp",
                  "alt": "SEEPEX Baureihe CS, Hygienepumpe für die Lebensmittel- und Pharmaindustrie, CIP/SIP-geeignet",
                  "width": 240,
                  "height": 158
                }
              },
              {
                "_uid": "e02de3472f49",
                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 3
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Seepex Baureihe CS"
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Diese Seepex-Pumpen werden in der chemischen, kosmetischen, pharmazeutischen und Lebensmittelindustrie eingesetzt. Die CIP- und SIP-Pumpen erfüllen hohe Anforderungen an Sterilisation, Reinigung und Hygiene. Damit werden zugleich die sanitären 3-A-Normen und die Richtlinien der EHEDG erfüllt."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Von dieser Baureihe liefern wir die Ausführungen: BCSO, BCSB, BTCS",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
