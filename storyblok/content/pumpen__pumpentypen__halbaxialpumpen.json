                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Hoher Wirkungsgrad",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Halbaxialpumpen sind dafür ausgelegt, große Wassermengen bei relativ niedrigen Drücken zu fördern, was zu hohem Wirkungsgrad und niedrigeren Energiekosten führt."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "_uid": "7294b20f62eb",
            "component": "section_column",
            "icon": "fa-cogs",
            "content": [
              {
