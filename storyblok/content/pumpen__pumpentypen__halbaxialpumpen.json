                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Kompakt und leicht",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Halbaxialpumpen sind meist kompakter und leichter als andere Pumpentypen, was Installation und Wartung vereinfacht und Platz spart."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "_uid": "fce4b3d26a12",
            "component": "section_column",
