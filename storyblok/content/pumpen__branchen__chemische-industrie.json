      {
        "_uid": "b3b21ec5b051",
        "component": "cta_band",
        "heading": "Unverbindlich Kontakt aufnehmen",
        "text": "Wir beraten Sie gern zu Auswahl, Ersatz und Revision Ihrer Pumpe.",
        "button_label": "Kontakt aufnehmen",
        "button_link": {
