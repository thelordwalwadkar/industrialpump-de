                              "attrs": {
                                "href": "/pumpen/pumpentypen/exzenterschneckenpumpen",
                                "linktype": "url"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Kreiselpumpen",
                          "marks": [
                            {
                              "type": "link",
                              "attrs": {
                                "href": "/pumpen/pumpentypen/kreiselpumpen",
                                "linktype": "url"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
