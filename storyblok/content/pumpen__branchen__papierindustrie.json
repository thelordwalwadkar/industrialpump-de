                            {
                              "type": "link",
                              "attrs": {
                                "href": "/pumpen/pumpentypen/axial-geteilte-pumpen",
                                "linktype": "url"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
