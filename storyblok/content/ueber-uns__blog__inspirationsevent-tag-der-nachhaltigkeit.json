      },
      {
        "_uid": "b74eba82115e",
        "component": "image_block",
        "image": {
          "filename": "/img/nl/dagvdduurzaamheid-avond.webp",
          "alt": "Netzwerkempfang am Abend des Tags der Nachhaltigkeit",
          "width": 1000,
