                          ]
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Schnelles und effizientes Fördern von Wasser, um Schäden an Eigentum und Kulturen zu vermeiden."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "_uid": "02546bf6b91b",
