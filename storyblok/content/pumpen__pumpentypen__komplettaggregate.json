            "component": "section_column",
            "content": [
              {
                "_uid": "36b93029684f",
                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Komplettlösung mit hervorragender Leistung!"
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Die Pumpeneinheiten von IPG sind langlebig und enthalten alle wesentlichen Komponenten, was uns bei Wartung und Installation Zeit und Kosten spart. Das Team hat uns während des gesamten Prozesses hervorragend unterstützt."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Projektleiter bei einem chemischen Produktionsbetrieb."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
