                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Einfach zu installieren und effizient im Betrieb!"
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Die Total Pump Units von IPG sind Plug-and-play, daher verlief die Installation schnell und problemlos. Sie arbeiten effizient und helfen uns, Prozesse ohne Unterbrechungen am Laufen zu halten."
                        }
