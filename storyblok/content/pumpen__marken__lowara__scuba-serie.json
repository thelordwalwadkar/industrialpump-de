                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Anwendungen"
                        }
                      ]
                    },
                    {
                      "type": "bullet_list",
                      "content": [
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Wasserzufuhr aus Reservoirs, 6″-Brunnen, Becken und Wasserläufen."
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Beregnung."
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Druckerhöhung mit einer Pumpe, die direkt in das Reservoir oder den Brunnen eingesetzt wird, sodass Probleme mit der Ansaugung und Geräuschbelästigung vermieden werden."
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
