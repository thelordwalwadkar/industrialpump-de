                    },
                    {
                      "type": "bullet_list",
                      "content": [
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Minimale Wahrscheinlichkeit unerwarteter Störungen"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Verlängerung der Lebensdauer der Pumpenanlage"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
