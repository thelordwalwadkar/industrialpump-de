                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Eintauchpumpen lassen sich einfach in bestehende Rohrleitungen einsetzen, was eine schnelle und problemlose Installation ermöglicht."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "_uid": "2c6d71291298",
            "component": "section_column",
            "icon": "fa-sync-alt",
            "content": [
              {
                "_uid": "b587561d31db",
                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Hoher Wirkungsgrad",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Auf hohen Wirkungsgrad ausgelegt und mit energiesparenden Motoren ausgestattet, sind sie im Betrieb kosteneffizient."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "_uid": "8d0e1f0da6e9",
            "component": "section_column",
            "icon": "fa-globe",
            "content": [
              {
                "_uid": "add5ff009eb4",
                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Flexibilität bei den Anwendungen",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Geeignet für verschiedene Flüssigkeiten wie Wasser, Chemikalien und Brennstoffe, angepasst an unterschiedliche industrielle Anforderungen."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "_uid": "ba2b841067e1",
            "component": "section_column",
            "icon": "fa-tools",
            "content": [
              {
                "_uid": "9fdd346a892a",
                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Niedrige Betriebskosten",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Erschwinglich in Anschaffung und Wartung und damit eine wirtschaftliche Wahl für unterschiedliche Anwendungen."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
