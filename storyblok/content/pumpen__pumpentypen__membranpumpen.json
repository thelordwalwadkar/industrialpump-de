                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Genaue Wasserförderung",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Membranpumpen können Wasser sehr genau dosieren, gut geeignet für Anwendungen wie die Präzisionsbewässerung, bei der exakte Wassermengen zu bestimmten Zeiten und an bestimmten Orten erforderlich sind."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "_uid": "1dd69ceefdd6",
            "component": "section_column",
            "icon": "fa-lightbulb",
            "content": [
              {
                "_uid": "066ccf82ea3d",
                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Energieeffizienz",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Diese Pumpen sind sehr energieeffizient, was zu deutlichen Kosteneinsparungen in Wasseraufbereitungsprozessen führt."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "_uid": "86cc219a97f1",
            "component": "section_column",
            "icon": "fa-tools",
            "content": [
              {
                "_uid": "4fa47ee8d96d",
                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Langlebigkeit und einfache Wartung",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Dank der Verschleißfestigkeit der Membrantechnologie haben diese Pumpen eine lange Lebensdauer und benötigen wenig Wartung, was sie wirtschaftlich und zuverlässig macht."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "_uid": "233a5f2fa603",
            "component": "section_column",
            "icon": "fa-sync-alt",
            "content": [
              {
                "_uid": "816aed54c2dd",
                "component": "rich_text",
