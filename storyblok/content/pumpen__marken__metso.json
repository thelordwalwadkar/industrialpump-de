              {
                "_uid": "b56d6b2a674d",
                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 2
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Metso "
                        },
                        {
                          "type": "text",
                          "text": "Sala VS Baureihe",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": ": Diese vertikalen Sumpfpumpen sind leistungsstarke Pumpen mit hoher Förderleistung, die weltweit in besonders anspruchsvollen Industrien eingesetzt werden. Bekannt für ihre Robustheit und leichte Wartung, sind diese Pumpen speziell für abrasive Schlämme ausgelegt."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
