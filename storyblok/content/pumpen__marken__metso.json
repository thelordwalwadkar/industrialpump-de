                      "content": [
                        {
                          "type": "text",
                          "text": "Metso "
                        },
                        {
                          "type": "text",
                          "text": "Sala VF Baureihe",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": ": Diese Pumpen erhöhen die Effizienz beim Fördern schäumender Schlämme. Sie eignen sich für alle Anwendungen, bei denen luftreiche Schlämme verarbeitet werden, etwa Flotationsschaum in Basismetall-Konzentratoren sowie in Phosphat- und Apatit-Waschanlagen."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "_uid": "720fe9e95642",
            "component": "section_column",
