              {
                "_uid": "2cab0d873e66",
                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 2
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Metso "
                        },
                        {
                          "type": "text",
                          "text": "Sala ST Baureihe",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": ": Diese vertikalen Induced-Flow-Pumpen sind robuste, universell einsetzbare Feststoff- und Schlammpumpen. Bekannt für ihre Induced-Flow-Laufräder und den geringen Verschleiß der geförderten Partikel, werden diese Pumpen häufig für den Kohlenstofftransport in Goldlaugungsprozessen und in anderen Anwendungen eingesetzt."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
