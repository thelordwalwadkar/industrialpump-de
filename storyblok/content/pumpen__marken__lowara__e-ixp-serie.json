      },
      {
        "_uid": "1413566d4734",
        "component": "rich_text",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "heading",
              "attrs": {
                "level": 2
              },
              "content": [
                {
                  "type": "text",
                  "text": "Interessiert an allen "
                },
                {
                  "type": "text",
                  "text": "Lowara-Pumpen",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "? Sehen Sie sich unser gesamtes Sortiment an"
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
