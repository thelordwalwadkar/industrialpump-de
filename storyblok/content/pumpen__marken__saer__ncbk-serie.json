                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Leistungsdaten der Pumpe"
                        }
                      ]
                    },
                    {
                      "type": "bullet_list",
                      "content": [
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Förderstrom bis 8 m³/h"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Förderhöhe bis 59 Meter"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Erforderliche Flüssigkeitsqualität: sauber, frei von Feststoffen oder abrasiven Stoffen"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Maximale Temperatur der geförderten Flüssigkeit -15 °C bis +70 °C"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Maximale Umgebungstemperatur 40 °C."
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Maximaler Betriebsdruck 9 bar."
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "list_item",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Die Toleranzen der hydraulischen Kenngrößen entsprechen UNI/ISO 2548, Klasse C, Anhang B; elektrische Kenngrößen nach C.E.I."
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
