                        "level": 4
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "IPG Pumpenschule: Kurse"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "_uid": "c5a29363271b",
            "component": "section_column",
            "content": [
              {
                "_uid": "0a84224b3dc2",
                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Bei IPG sind wir stolz auf unsere Fachkompetenz und unsere langjährige Erfahrung in der Pumpenbranche. Unser Expertenteam vermittelt Ihnen aktuelles Wissen und Fertigkeiten rund um Pumpen. Ob Einsteiger oder mit Erfahrung: Bei der Industrial Pump Group gibt es einen Kurs, der zu Ihrem Bedarf und Ihren Zielen passt. Unsere Kurse sollen den Teilnehmern helfen, ihr Wissen und ihre Fertigkeiten rund um Pumpen zu erweitern und zu vertiefen."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "_uid": "3ecb912fc5aa",
        "component": "section_row",
        "layout": "columns",
        "columns": [
          {
            "_uid": "9d319d7d124f",
            "component": "section_column",
            "content": [
              {
                "_uid": "f95cf15da397",
                "component": "rich_text",
                "content": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Die Industrial Pump Group (IPG) bietet ein breites Spektrum an Pumpenkursen an, darunter Grundlagen Pumpen und vertiefende Kurse. So kann jeder Teilnehmer auf seinem eigenen Niveau lernen und sein Wissen und seine Fertigkeiten rund um Pumpen verbessern."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Mit einem Pumpenkurs können Teilnehmer ihr Wissen und ihr Verständnis von Pumpen und ihren Komponenten verbessern, was zu einem besseren Verständnis des Pumpensystems führt."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "_uid": "5111b20f250b",
            "component": "section_column",
            "content": [
              {
                "_uid": "41e55207c6e5",
                "component": "faq",
                "heading": "Häufige Fragen",
                "items": [
                  {
                    "_uid": "2c18408e998a",
                    "component": "faq_item",
                    "question": "Für wen sind die Pumpenkurse gedacht?",
                    "answer": "Personen, die Pumpen warten und/oder Störungen an Pumpen beheben müssen.\nOperatoren, die für die Wartung erster Ebene an Pumpen verantwortlich sind."
                  },
                  {
                    "_uid": "8b97fbbabe29",
                    "component": "faq_item",
                    "question": "Wie lange dauern die Pumpenkurse?",
                    "answer": "Die Dauer der Kurse variiert und hängt vom gewählten Kurs ab. Einige Kurse dauern nur einen Tag, andere mehrere Tage."
                  },
                  {
                    "_uid": "dd08b7f65937",
                    "component": "faq_item",
                    "question": "Können die Kurse an die Bedürfnisse des Kunden angepasst werden?",
                    "answer": "Ja, wir können unsere Kurse an die besonderen Bedürfnisse des Kunden anpassen. Nehmen Sie Kontakt mit uns auf, um Ihren konkreten Bedarf zu besprechen."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "_uid": "e7613e15f05a",
        "component": "rich_text",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "heading",
              "attrs": {
                "level": 3
              },
              "content": [
                {
                  "type": "text",
                  "text": "Kurs für Ihre Organisation"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Bei den Kursen der Industrial Pump Group ist es üblich, dass die Organisation den Kurs für ihre Mitarbeiter ausrichtet. Der Kursleiter von IPG kommt zu Ihnen vor Ort und hält den Kurs an einem oder mehreren Tagen. Andere Formen sind ebenfalls denkbar, etwa ein Einzelkurs mit dem Kursleiter."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Möchten Sie alle Möglichkeiten kennenlernen?",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "hard_break"
                },
                {
                  "type": "text",
                  "text": "Das IPG-Team mit engagierten Pumpenexperten steht für Sie bereit."
                },
                {
                  "type": "hard_break"
                },
                {
                  "type": "text",
                  "text": "Nehmen Sie schnell über das Formular Kontakt auf oder rufen Sie"
                },
                {
                  "type": "hard_break"
                },
                {
                  "type": "text",
                  "text": "werktags zwischen 08:00 und 17:00 Uhr an."
                },
                {
                  "type": "hard_break"
                },
                {
                  "type": "text",
                  "text": "Tel. +31 251 222 566",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
