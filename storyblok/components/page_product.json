{
  "component": {
    "name": "page_product",
    "display_name": "T6 · Produkt (L3)",
    "is_root": true,
    "is_nestable": false,
    "schema": {
      "h1": {
        "type": "text",
        "description": "Haupt-Überschrift (genau ein H1 pro Seite). Enthält das Hauptthema.",
        "required": true,
        "pos": 0
      },
      "intro": {
        "type": "textarea",
        "description": "Einleitung in höchstens zwei Sätzen: Was ist das und für wen? Wird als Zitat-Antwort gelesen.",
        "required": true,
        "max_length": 320,
        "pos": 1
      },
      "nav_title": {
        "type": "text",
        "description": "Kurzname für Brotkrumen, Navigation und Karten (z. B. „DIWA-Serie“).",
        "pos": 2
      },
      "hero_image": {
        "type": "asset",
        "filetypes": [
          "images"
        ],
        "description": "Kopfbild (optional): ersetzt das Standardbild hinter Überschrift und Einleitung.",
        "pos": 3
      },
      "seo_title": {
        "type": "text",
        "description": "Seitentitel für Google, höchstens 60 Zeichen.",
        "max_length": 60,
        "required": true,
        "pos": 4
      },
      "seo_description": {
        "type": "textarea",
        "description": "Meta-Beschreibung, höchstens 155 Zeichen.",
        "max_length": 155,
        "required": true,
        "pos": 5
      },
      "noindex": {
        "type": "boolean",
        "description": "Nur für Sonderfälle: Seite von der Suche ausschließen. Rechtstexte bleiben indexierbar.",
        "default_value": false,
        "pos": 6
      },
      "article_number": {
        "type": "text",
        "description": "Artikel-/Modellbezeichnung des Herstellers (wird zu SKU, MPN und URL).",
        "required": true,
        "pos": 7
      },
      "name": {
        "type": "text",
        "description": "Produktname (z. B. „DIWA 07/B“).",
        "required": true,
        "pos": 8
      },
      "short_description": {
        "type": "textarea",
        "description": "Kurzbeschreibung, 60–120 Wörter.",
        "required": true,
        "pos": 9
      },
      "image": {
        "type": "asset",
        "filetypes": [
          "images"
        ],
        "description": "Produktbild.",
        "pos": 10
      },
      "image_source": {
        "type": "text",
        "description": "Quellpfad des Bildes im Altsystem.",
        "pos": 11
      },
      "gallery": {
        "type": "multiasset",
        "filetypes": [
          "images"
        ],
        "description": "Weitere Bilder.",
        "pos": 12
      },
      "highlights": {
        "type": "textarea",
        "description": "Merkmale, eine Zeile pro Punkt.",
        "pos": 13
      },
      "key_facts": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "key_fact"
        ],
        "description": "Genau bis zu 4 Kennwerte für die Kennwert-Leiste.",
        "maximum": 4,
        "pos": 14
      },
      "specs": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "spec_row"
        ],
        "description": "Technische Daten, gruppiert (Hydraulik, Motor/Elektrik, Werkstoffe, Anschlüsse & Abmessungen). Leere Werte weglassen.",
        "pos": 15
      },
      "flow_max_m3h": {
        "type": "number",
        "description": "Förderstrom max. in m³/h (Zahl, für Filter und Schema).",
        "pos": 16
      },
      "head_max_m": {
        "type": "number",
        "description": "Förderhöhe max. in m (Zahl).",
        "pos": 17
      },
      "power_kw": {
        "type": "number",
        "description": "Motorleistung in kW (Zahl).",
        "pos": 18
      },
      "voltage": {
        "type": "option",
