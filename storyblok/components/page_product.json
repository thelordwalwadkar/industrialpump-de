        "options": [
          {
            "name": "230 V",
            "value": "230 V"
          },
          {
            "name": "400 V",
            "value": "400 V"
          },
          {
            "name": "230/400 V",
            "value": "230/400 V"
          },
          {
            "name": "400/690 V",
            "value": "400/690 V"
          }
        ],
        "description": "Spannung (Filter).",
        "pos": 19
      },
      "material": {
        "type": "option",
        "source": "self",
        "options": [
          {
            "name": "Gusseisen",
            "value": "Gusseisen"
          },
          {
            "name": "Edelstahl",
            "value": "Edelstahl"
          },
          {
            "name": "Bronze",
            "value": "Bronze"
          },
          {
            "name": "Thermoplast",
            "value": "Thermoplast"
          },
          {
            "name": "Messing",
            "value": "Messing"
          },
          {
            "name": "Stahlguss",
            "value": "Stahlguss"
          }
        ],
        "description": "Werkstoff Gehäuse (Filter).",
        "pos": 20
      },
      "downloads": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "download_list"
        ],
        "description": "Datenblatt, Kennlinie, Handbuch.",
        "maximum": 1,
        "pos": 21
      },
      "gtin": {
        "type": "text",
        "description": "GTIN/EAN (optional).",
        "pos": 22
      },
      "price": {
        "type": "number",
        "description": "Preis in EUR – nur ausfüllen, wenn ein verbindlicher Preis vorliegt. Erzeugt sonst kein Angebots-Schema.",
        "pos": 23
      },
      "availability": {
        "type": "option",
        "source": "self",
        "options": [
          {
            "name": "InStock",
            "value": "InStock"
          },
          {
            "name": "OutOfStock",
            "value": "OutOfStock"
          },
          {
            "name": "PreOrder",
            "value": "PreOrder"
          },
          {
            "name": "BackOrder",
            "value": "BackOrder"
          },
          {
            "name": "LimitedAvailability",
            "value": "LimitedAvailability"
          }
        ],
        "description": "Verfügbarkeit (nur mit Preis).",
        "pos": 24
      },
      "internal_item_number": {
        "type": "text",
        "description": "Interne Artikelnummer (nicht öffentlich ausgespielt).",
        "pos": 25
      },
      "body": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "rich_text",
          "card_grid",
          "cta_band",
          "faq",
          "spec_table",
          "download_list",
          "steps",
          "related_links",
          "image_text",
          "image_block",
          "data_table",
          "button_row",
          "pump_finder",
          "logo_carousel",
          "usp_grid",
          "section_row"
        ],
        "description": "Optionale Zusatz-Bausteine. Die Pflicht-Abschnitte sind im Template fest eingebaut.",
        "pos": 26
      },
      "cta": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "cta_band"
        ],
        "description": "Optionales Abschluss-Banner. Ohne Eintrag erscheint der Standard-CTA des Templates.",
        "maximum": 1,
        "pos": 27
      },
      "tab-seo": {
        "type": "tab",
        "display_name": "SEO",
        "keys": [
          "seo_title",
          "seo_description",
          "noindex"
        ]
      }
    }
  }
