        "pos": 5
      },
      "service_kind": {
        "type": "option",
        "source": "self",
        "options": [
          {
            "name": "Revision",
            "value": "revision"
          },
          {
            "name": "Revision nach Pumpentyp",
            "value": "revision-typ"
          },
          {
            "name": "Wartung",
            "value": "wartung"
          },
          {
            "name": "Inspektion",
            "value": "inspektion"
          },
          {
            "name": "Leistung",
            "value": "leistung"
          }
        ],
        "description": "Art der Leistung. Revision-Seiten nutzen die Overhaul-Farbe.",
        "required": true,
        "pos": 6
      },
      "service_type": {
        "type": "text",
        "description": "Leistungsart für Schema, z. B. „Pumpenrevision“.",
        "pos": 7
      },
      "steps": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "steps"
