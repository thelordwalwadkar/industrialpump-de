        "description": "Abgedeckte Pumpentypen / Marken.",
        "pos": 10
      },
      "faq": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "faq"
        ],
        "description": "FAQ-Block (3–5 Fragen). Erzeugt auch FAQPage-Daten.",
        "maximum": 1,
        "pos": 11
      },
      "body": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "rich_text",
          "card_grid",
          "cta_band",
          "faq",
          "spec_table",
          "download_list",
          "steps",
          "related_links",
          "image_text",
          "image_block",
