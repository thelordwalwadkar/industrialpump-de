        "pos": 5
      },
      "series_name": {
        "type": "text",
        "description": "Serienname ohne „-Serie“ (z. B. „DIWA“). Der URL-Slug lautet „diwa-serie“.",
        "required": true,
        "pos": 6
      },
      "pump_type": {
        "type": "option",
        "source": "self",
        "options": [
          {
            "name": "Kreiselpumpen",
            "value": "kreiselpumpen"
          },
          {
            "name": "Mehrstufige Pumpen",
            "value": "mehrstufige-pumpen"
          },
          {
            "name": "Blockpumpen",
            "value": "blockpumpen"
          },
          {
            "name": "Tauchmotorpumpen",
            "value": "tauchmotorpumpen"
          },
          {
            "name": "Druckerhöhungsanlagen",
            "value": "druckerhoehungsanlagen"
          }
        ],
        "description": "Pumpentyp (verbindet Serien markenübergreifend).",
        "required": true,
        "pos": 7
      },
      "segments": {
        "type": "options",
        "source": "self",
        "options": [
          {
            "name": "Gebäudetechnik / HVAC",
            "value": "gebaeudetechnik-hvac"
          },
          {
            "name": "Wasseraufbereitung",
            "value": "wasseraufbereitung"
          },
          {
            "name": "Wassertransport",
            "value": "wassertransport"
          },
          {
            "name": "Landwirtschaft",
            "value": "landwirtschaft"
          }
        ],
        "description": "Branchen (aus den Produktdaten).",
        "pos": 8
      },
      "applications": {
        "type": "options",
        "source": "self",
        "options": [
          {
            "name": "Entwässerung",
            "value": "entwaesserung"
          },
          {
            "name": "Abwasser",
            "value": "abwasser"
          }
