{
  "component": {
    "name": "page_knowledge",
    "display_name": "T9 · Wissensartikel",
    "is_root": true,
    "is_nestable": false,
    "schema": {
      "h1": {
        "type": "text",
        "description": "Haupt-Überschrift (genau ein H1 pro Seite). Enthält das Hauptthema.",
        "required": true,
        "pos": 0
      },
      "intro": {
        "type": "textarea",
        "description": "Einleitung in höchstens zwei Sätzen: Was ist das und für wen? Wird als Zitat-Antwort gelesen.",
        "required": true,
        "max_length": 320,
        "pos": 1
      },
      "nav_title": {
        "type": "text",
        "description": "Kurzname für Brotkrumen, Navigation und Karten (z. B. „DIWA-Serie“).",
        "pos": 2
      },
      "seo_title": {
        "type": "text",
        "description": "Seitentitel für Google, höchstens 60 Zeichen.",
        "max_length": 60,
        "required": true,
        "pos": 3
      },
      "seo_description": {
        "type": "textarea",
        "description": "Meta-Beschreibung, höchstens 155 Zeichen.",
        "max_length": 155,
        "required": true,
        "pos": 4
      },
      "noindex": {
        "type": "boolean",
        "description": "Nur für Sonderfälle: Seite von der Suche ausschließen. Rechtstexte bleiben indexierbar.",
        "default_value": false,
        "pos": 5
      },
      "article": {
        "type": "richtext",
        "description": "Artikeltext. Zwischenüberschriften (H2) erzeugen das Inhaltsverzeichnis.",
        "rich_markdown": false,
        "pos": 6
      },
      "author": {
        "type": "text",
        "description": "Autor (optional, sonst Organisation).",
        "pos": 7
      },
      "tech": {
        "type": "boolean",
        "description": "Technischer Artikel (TechArticle).",
        "default_value": false,
        "pos": 8
      },
      "downloads": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "download_list"
        ],
        "description": "Downloads.",
        "maximum": 1,
        "pos": 9
      },
      "related": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "related_links"
        ],
        "description": "Verwandte Themen.",
        "maximum": 1,
        "pos": 10
      },
      "body": {
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "rich_text",
          "card_grid",
          "cta_band",
          "faq",
          "spec_table",
          "download_list",
          "steps",
          "related_links",
          "image_text"
        ],
        "description": "Optionale Zusatz-Bausteine. Die Pflicht-Abschnitte sind im Template fest eingebaut.",
        "pos": 11
      },
      "tab-seo": {
        "type": "tab",
        "display_name": "SEO",
        "keys": [
          "seo_title",
          "seo_description",
          "noindex"
        ]
      }
    }
  }
}
