---
/** Logo-Karussell (Marken, Kunden): läuft endlos durch, hält bei Hover/Fokus an; bei „reduzierter Bewegung“ als ruhiges Raster. */
import type { LogoCarousel } from '../lib/types';
import type { Site } from '../lib/storyblok';
import { resolveLink } from '../lib/links';
import { sbImage } from '../lib/images';
interface Props { blok: LogoCarousel; site: Site }
const { blok, site } = Astro.props;
const logos = (blok.logos ?? []).flatMap((l) => {
  const img = sbImage(l.image, 240, 120);
  if (!img) return [];
  const r = l.link ? resolveLink(site, l.link) : undefined;
  return [{ name: l.name, img, href: r && r.exists ? r.href : undefined }];
});
---
{logos.length > 0 && (
  <section class="section logo-carousel" aria-label={blok.heading ?? 'Logos'}>
    <div class="wrap">
      {blok.heading && <h2>{blok.heading}</h2>}
      {blok.intro && <p>{blok.intro}</p>}
    </div>
    <div class="marquee">
      {/* the list is rendered twice so the loop is seamless; the copy is hidden from assistive technology */}
      {[false, true].map((copy) => (
        <ul class="marquee__track" aria-hidden={copy ? 'true' : undefined}>
          {logos.map((l) => {
            const pic = <img src={l.img.src} width={l.img.width} height={l.img.height} alt={copy ? '' : l.name} loading="lazy" decoding="async" />;
            return <li>{l.href ? <a href={l.href} tabindex={copy ? -1 : undefined}>{pic}</a> : pic}</li>;
          })}
        </ul>
      ))}
    </div>
  </section>
)}
