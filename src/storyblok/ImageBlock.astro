---
import type { ImageBlock } from '../lib/types';
import { sbImage } from '../lib/images';
interface Props { blok: ImageBlock }
const { blok } = Astro.props;
const img = sbImage(blok.image, 1000, 560);
---
{img && (
  <figure class="content-figure">
    <div class="wrap">
      <img src={img.src} srcset={img.srcset} width={img.width} height={img.height} alt={blok.image?.alt ?? ''} loading="lazy" decoding="async" />
      {blok.caption && <figcaption>{blok.caption}</figcaption>}
    </div>
  </figure>
)}
