---
/** T8 · page_course — Intro · Lernziele · Zielgruppe · Dauer/Format · Termine (falls vorhanden) · Anmeldung */
import type { PageCourse, PageStory } from '../lib/types';
import type { Site } from '../lib/storyblok';
import PageHead from '../components/PageHead.astro';
import RichTextHtml from '../components/RichTextHtml.astro';
import QuoteCta from '../components/QuoteCta.astro';
import Bloks from '../components/Bloks.astro';
interface Props { story: PageStory<PageCourse>; site: Site }
const { story, site } = Astro.props;
const c = story.content;
const MODE = { onsite: 'Präsenz', online: 'Online', blended: 'Blended Learning' } as const;
---
<PageHead story={story} site={site} h1={c.h1 || story.name} intro={c.intro} />
{c.goals && <section class="section"><div class="wrap"><h2>Lernziele</h2><RichTextHtml doc={c.goals} /></div></section>}
<section class="section">
  <div class="wrap">
    <h2>Zielgruppe, Dauer und Format</h2>
    <dl class="kv">
      {c.audience && <><dt>Zielgruppe</dt><dd>{c.audience}</dd></>}
      {c.duration && <><dt>Dauer</dt><dd>{c.duration}</dd></>}
      {c.mode && <><dt>Format</dt><dd>{MODE[c.mode]}</dd></>}
      {c.level && <><dt>Niveau</dt><dd>{c.level}</dd></>}
    </dl>
  </div>
</section>
{c.dates && <section class="section"><div class="wrap"><h2>Termine</h2><p>{c.dates}</p></div></section>}
<Bloks bloks={c.body} site={site} />
<div class="wrap"><QuoteCta heading="Anmeldung" text="Schreiben Sie uns kurz, an welchem Kurs Sie teilnehmen möchten." label="Kurs anfragen" href="/kontakt" /></div>
<Bloks bloks={c.cta} site={site} />
