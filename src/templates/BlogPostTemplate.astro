---
/** T10 · page_blog_post — Titel · Autor · Datum · Text · verwandte Beiträge · CTA */
import type { PageBlogPost, PageStory } from '../lib/types';
import type { Site } from '../lib/storyblok';
import { fmtDate } from '../lib/format';
import PageHead from '../components/PageHead.astro';
import RichTextHtml from '../components/RichTextHtml.astro';
import RelatedLinks from '../storyblok/RelatedLinks.astro';
import QuoteCta from '../components/QuoteCta.astro';
import { hasOwnCta } from '../lib/page-cta';
import Bloks from '../components/Bloks.astro';
interface Props { story: PageStory<PageBlogPost>; site: Site }
const { story, site } = Astro.props;
const c = story.content;
const date = fmtDate(story.first_published_at ?? story.created_at);
---
<PageHead story={story} site={site} h1={c.h1 || story.name} intro={c.intro}>
  <p class="muted" style="margin-top:1rem">{c.author ? `Von ${c.author}` : ''}{c.author && date ? ' · ' : ''}{date && <time datetime={story.first_published_at ?? story.created_at}>{date}</time>}</p>
</PageHead>
{c.article?.content?.length ? <section class="section"><div class="wrap"><RichTextHtml doc={c.article} /></div></section> : null}
<Bloks bloks={c.body} site={site} />
{c.related?.map((b) => <RelatedLinks blok={b} site={site} />)}
{!hasOwnCta(c) && <div class="wrap"><QuoteCta heading="Pumpe auslegen lassen" text="Senden Sie uns Typenschild oder Betriebsdaten." label="Angebot anfordern" href="/angebot" /></div>}
