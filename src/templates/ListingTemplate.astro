---
/** T12 · page_listing — paginierte Liste der Unterseiten (/blog, /referenzen). Seite n>1 liegt unter {slug}/seite/{n}. */
import type { PageListing, PageStory } from '../lib/types';
import type { Site } from '../lib/storyblok';
import { childCards } from '../lib/linking';
import { pathOf } from '../lib/storyblok';
import PageHead from '../components/PageHead.astro';
import LinkCards from '../components/LinkCards.astro';
import Bloks from '../components/Bloks.astro';
interface Props { story: PageStory<PageListing>; site: Site; page?: number }
const { story, site, page = 1 } = Astro.props;
const c = story.content;
const perPage = Math.max(1, Number(c.per_page ?? 10) || 10);
const all = childCards(site, story);
const pages = Math.max(1, Math.ceil(all.length / perPage));
const cards = all.slice((page - 1) * perPage, page * perPage);
const base = pathOf(story);
const href = (n: number) => (n === 1 ? base : `${base}/seite/${n}`);
---
<PageHead story={story} site={site} h1={c.h1 || story.name} intro={c.intro} />
<section class="section">
  <div class="wrap">
    {cards.length > 0 ? <LinkCards cards={cards} showImage={false} /> : <p>Hier erscheinen in Kürze die ersten Einträge.</p>}
    {pages > 1 && (
      <nav aria-label="Seitennavigation" class="btn-row">
        {page > 1 && <a class="btn btn--ghost" href={href(page - 1)} rel="prev">Vorherige Seite</a>}
        <span class="muted num" style="align-self:center">Seite {page} von {pages}</span>
        {page < pages && <a class="btn btn--ghost" href={href(page + 1)} rel="next">Nächste Seite</a>}
      </nav>
    )}
  </div>
</section>
<Bloks bloks={c.body} site={site} />
<Bloks bloks={c.cta} site={site} />
